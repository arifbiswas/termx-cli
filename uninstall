#!/usr/bin/env bash
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$DIR/src/windows/termx.ps1")" uninstall "$@" ;;
  *) T="$HOME/.termx/bin/termx"; [ -x "$T" ] || T="$DIR/src/unix/termx"; exec bash "$T" uninstall "$@" ;;
esac
